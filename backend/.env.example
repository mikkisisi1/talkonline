# TalkMe Backend Environment Variables
MONGO_URL=mongodb://localhost:27017
DB_NAME=talkmee_db
CORS_ORIGINS=*

# DeepSeek API Key (for AI chat with minimal content filters)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key_here

# Fish Audio API Key (for TTS)
# Get your key from: https://fish.audio/
FISH_AUDIO_API_KEY=your_fish_audio_key_here
